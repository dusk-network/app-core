{
  "name": "@dusk-network/app-core",
  "version": "0.8.2",
  "description": "Shared logic for the Dusk apps: amounts, text a person must trust, payment links and requests, names that look alike, public and shielded history, activity rows, an accountant's export, Sozu positions and growth, bridge arrivals, ledgers and status, and DuskEVM withdrawals.",
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dusk-network/app-core.git"
  },
  "exports": {
    "./amounts": {
      "types": "./src/amounts.d.ts",
      "default": "./src/amounts.js"
    },
    "./text": {
      "types": "./src/text.d.ts",
      "default": "./src/text.js"
    },
    "./payment-links": {
      "types": "./src/payment-links.d.ts",
      "default": "./src/payment-links.js"
    },
    "./requests": {
      "types": "./src/requests.d.ts",
      "default": "./src/requests.js"
    },
    "./names": {
      "types": "./src/names.d.ts",
      "default": "./src/names.js"
    },
    "./history": {
      "types": "./src/history.d.ts",
      "default": "./src/history.js"
    },
    "./shielded": {
      "types": "./src/shielded.d.ts",
      "default": "./src/shielded.js"
    },
    "./activity": {
      "types": "./src/activity.d.ts",
      "default": "./src/activity.js"
    },
    "./export": {
      "types": "./src/export.d.ts",
      "default": "./src/export.js"
    },
    "./sozu": {
      "types": "./src/sozu.d.ts",
      "default": "./src/sozu.js"
    },
    "./bridge": {
      "types": "./src/bridge.d.ts",
      "default": "./src/bridge.js"
    },
    "./bridge-explorer": {
      "types": "./src/bridge-explorer.d.ts",
      "default": "./src/bridge-explorer.js"
    },
    "./duskevm-withdrawals": {
      "types": "./src/duskevm-withdrawals.d.ts",
      "default": "./src/duskevm-withdrawals.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.18.0",
      "onFail": "error"
    }
  },
  "allowScripts": {},
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "npx --yes --package=typescript@5.9.3 -- tsc -p test-types",
    "check:versions": "node scripts/check-versions.js",
    "check:jsr": "npx --yes jsr@0.14.3 publish --dry-run --allow-dirty",
    "generate:confusables": "node scripts/generate-confusables.js",
    "fetch:drivers": "node scripts/fetch-drivers.js",
    "smoke:history": "node scripts/smoke-history.js",
    "smoke:bridge": "node scripts/smoke-bridge.js",
    "smoke:withdrawals": "node scripts/smoke-withdrawals.js"
  },
  "dependencies": {
    "@dusk-network/networks": "0.3.2"
  },
  "peerDependencies": {
    "viem": "^2.55.2"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "viem": "2.55.2"
  }
}
