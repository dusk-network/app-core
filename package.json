{
  "name": "@dusk-network/app-core",
  "version": "0.1.0",
  "description": "Shared logic for the Dusk apps: public and shielded history, activity rows, bridge arrivals and DuskEVM withdrawals.",
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dusk-network/app-core.git"
  },
  "exports": {
    "./history": {
      "types": "./src/history.d.ts",
      "default": "./src/history.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "npx --yes --package=typescript@5.9.3 -- tsc -p test-types",
    "check:versions": "node scripts/check-versions.js",
    "check:jsr": "npx --yes jsr@0.14.3 publish --dry-run --allow-dirty",
    "smoke:history": "node scripts/smoke-history.js"
  },
  "dependencies": {
    "@dusk-network/networks": "0.3.0"
  }
}
